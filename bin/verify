#!/usr/bin/env python3
"""
Verify CLI — quick access to free verification resources.
Usage:
    verify sms          # show SMS services
    verify email        # show email services
    verify card         # show credit card test resources
    verify all          # show everything
    verify sms 3        # show #3 from SMS list
"""
import json
import sys
from pathlib import Path

RESOURCES_FILE = Path(__file__).parent.parent / "data" / "verification_resources.json"


def load():
    with open(RESOURCES_FILE) as f:
        return json.load(f)


def show_section(name, data, idx=None):
    sites = data["sites"]
    print(f"\n{'='*60}")
    print(f"  {name.upper()} — {len(sites)} services")
    print(f"{'='*60}")
    if data.get("warning"):
        print(f"⚠️  {data['warning']}\n")
    if idx is not None:
        sites = [sites[idx-1]]
    for i, s in enumerate(sites, 1):
        print(f"{i}. {s['name']}")
        print(f"   URL: {s['url']}")
        for k, v in s.items():
            if k not in ('name', 'url'):
                print(f"   {k}: {v}")
        print()


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return
    data = load()
    cat = args[0]
    idx = int(args[1]) if len(args) > 1 and args[1].isdigit() else None
    if cat == "all":
        for k in ("sms", "email", "credit_card"):
            show_section(k, data["verification_resources"][k], idx)
    elif cat in ("sms", "email", "credit_card"):
        show_section(cat, data["verification_resources"][cat], idx)
    else:
        print(f"Unknown category: {cat}. Use: sms, email, credit_card, all")


if __name__ == "__main__":
    main()
